# A Podman Quadlet: the server as a systemd service (it shows in Cockpit's Podman and Services pages).
#
#   Rootless: copy to ~/.config/containers/systemd/, then
#     systemctl --user daemon-reload && systemctl --user start superawesomemagicalorchestrator
#     loginctl enable-linger $USER     (keeps it running when you're logged out)
#   System-wide: copy to /etc/containers/systemd/, then
#     sudo systemctl daemon-reload && sudo systemctl start superawesomemagicalorchestrator
#
# The first start logs the break-glass admin's password:
#   journalctl --user -u superawesomemagicalorchestrator | grep -A3 "break-glass"

[Unit]
Description=SuperAwesomeMagicalOrchestrator server
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/603madison/superawesomemagicalorchestrator:latest
ContainerName=superawesomemagicalorchestrator
# Behind a reverse proxy (with SAMO_TRUST_PROXY), publish on this machine only, so nobody on the
# network can reach it around the proxy: PublishPort=127.0.0.1:8095:8080
PublishPort=8095:8080
# A named volume; or a folder, e.g. Volume=%h/superawesomemagicalorchestrator:/data:Z
Volume=superawesomemagicalorchestrator-data:/data:Z
Environment=TZ=America/New_York
# Environment=SAMO_PUBLIC_URL=https://video.example.com
# Environment=SAMO_TRUST_PROXY=true
# Secrets are better in a file only you can read:
# EnvironmentFile=%h/.config/superawesomemagicalorchestrator.env
AutoUpdate=registry
HealthCmd=wget -qO /dev/null http://127.0.0.1:8080/api/health || exit 1
HealthInterval=30s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
